import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
}

Deno.serve(async (req) => {
  if (req.method === "OPTIONS") {
    return new Response("ok", { headers: corsHeaders });
  }

  try {
    if (req.method !== "POST") {
      return jsonResponse({ error: "Método não permitido" }, 405);
    }

    const supabaseUrl = Deno.env.get("SUPABASE_URL");
    const serviceRoleKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");
    const authHeader = req.headers.get("Authorization");

    if (!supabaseUrl || !serviceRoleKey) {
      return jsonResponse({ error: "Secrets do Supabase não configurados" }, 500);
    }

    if (!authHeader) {
      return jsonResponse({ error: "Authorization header ausente" }, 401);
    }

    const adminClient = createClient(supabaseUrl, serviceRoleKey);

    const token = authHeader.replace("Bearer ", "").trim();
    const {
      data: { user: callerUser },
      error: callerError,
    } = await adminClient.auth.getUser(token);

    if (callerError || !callerUser) {
      return jsonResponse({ error: "Usuário chamador não autenticado" }, 401);
    }

    const { data: callerPerfil, error: perfilError } = await adminClient
      .from("perfis")
      .select("id, role, ativo")
      .eq("id", callerUser.id)
      .maybeSingle();

    if (perfilError) {
      return jsonResponse({ error: "Erro ao validar perfil do chamador" }, 500);
    }

    if (!callerPerfil || !callerPerfil.ativo) {
      return jsonResponse({ error: "Perfil do chamador inativo ou inexistente" }, 403);
    }

    const body = await req.json();
    const nome = String(body?.nome || "").trim();
    const email = String(body?.email || "").trim().toLowerCase();
    const password = String(body?.password || "");
    const role = String(body?.role || "usuario").trim();

    if (!nome || !email || !password) {
      return jsonResponse({ error: "Nome, email e senha são obrigatórios" }, 400);
    }

    if (password.length < 6) {
      return jsonResponse({ error: "A senha deve ter no mínimo 6 caracteres" }, 400);
    }

    const ROLES_VALIDAS = ["usuario", "admin", "admin_master"];
    if (!ROLES_VALIDAS.includes(role)) {
      return jsonResponse({ error: `Role inválida. Valores permitidos: ${ROLES_VALIDAS.join(", ")}` }, 400);
    }

    const callerRole = callerPerfil.role;

    // Hierarquia: admin_master cria qualquer role; admin cria apenas usuario e editor
    if (!["admin", "admin_master"].includes(callerRole)) {
      return jsonResponse(
        { error: "Você não tem permissão para criar usuários" },
        403,
      );
    }

    if (callerRole === "admin" && !["usuario", "editor"].includes(role)) {
      return jsonResponse(
        { error: "Admins só podem criar usuários com perfil usuario ou editor" },
        403,
      );
    }

    const { data: existingPerfil } = await adminClient
      .from("perfis")
      .select("id, email")
      .eq("email", email)
      .maybeSingle();

    if (existingPerfil) {
      return jsonResponse({ error: "Já existe um perfil com este e-mail" }, 409);
    }

    const { data: createdUser, error: createError } =
      await adminClient.auth.admin.createUser({
        email,
        password,
        email_confirm: true,
        user_metadata: { nome },
      });

    if (createError || !createdUser?.user) {
      return jsonResponse(
        { error: createError?.message || "Erro ao criar usuário no Auth" },
        500,
      );
    }

    const newUserId = createdUser.user.id;

    const { error: perfilInsertError } = await adminClient
      .from("perfis")
      .upsert([
        {
          id: newUserId,
          nome,
          email,
          role,
          ativo: true,
        },
      ]);

    if (perfilInsertError) {
      await adminClient.auth.admin.deleteUser(newUserId);
      return jsonResponse(
        { error: "Usuário criado no Auth, mas falhou ao criar perfil. Operação revertida." },
        500,
      );
    }

    return jsonResponse({
      success: true,
      message: "Usuário criado com sucesso",
      user: {
        id: newUserId,
        nome,
        email,
        role,
      },
    });
  } catch (err) {
    console.error("Erro inesperado em create-user:", err);
    return jsonResponse({
      error: err instanceof Error ? err.message : "Erro interno inesperado",
    }, 500);
  }
});

function jsonResponse(data: unknown, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: corsHeaders,
  });
}
