import { serve } from "https://deno.land/std@0.168.0/http/server.ts"
import { createClient } from "https://esm.sh/@supabase/supabase-js@2.39.3"

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
}

// ── Helpers ────────────────────────────────────────────────────────────────

async function getSupabaseAdmin() {
  return createClient(
    Deno.env.get('SUPABASE_URL') ?? '',
    Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') ?? ''
  )
}

// Lê configurações do Telegram do banco, com fallback para Secrets
async function getTelegramConfig(): Promise<{ botToken: string; groups: Record<string, string> }> {
  const sbAdmin = await getSupabaseAdmin()
  const { data } = await sbAdmin.from('telegram_config').select('chave,valor')

  const config: Record<string, string> = {}
  if (data) {
    data.forEach((row: { chave: string; valor: string }) => {
      config[row.chave] = row.valor
    })
  }

  const botToken = config['BOT_TOKEN'] || Deno.env.get('TELEGRAM_BOT_TOKEN') || ''
  const groups: Record<string, string> = {}
  for (const regiao of ['NORTE', 'SUL', 'SERRA', 'TAQUARI']) {
    groups[regiao] = config[`GROUP_${regiao}`] || Deno.env.get(`TELEGRAM_GROUP_${regiao}`) || ''
  }

  return { botToken, groups }
}

async function validarJWT(req: Request): Promise<boolean> {
  const authHeader = req.headers.get('Authorization')
  if (!authHeader) return false

  const token = authHeader.replace('Bearer ', '')
  const supabase = createClient(
    Deno.env.get('SUPABASE_URL') ?? '',
    Deno.env.get('SUPABASE_ANON_KEY') ?? ''
  )
  const { data: { user }, error } = await supabase.auth.getUser(token)
  return !error && !!user
}

function erroResp(msg: string, status = 400) {
  return new Response(JSON.stringify({ error: msg }), {
    headers: { ...corsHeaders, 'Content-Type': 'application/json' },
    status,
  })
}

function okResp(msg: string) {
  return new Response(JSON.stringify({ success: true, message: msg }), {
    headers: { ...corsHeaders, 'Content-Type': 'application/json' },
    status: 200,
  })
}

// ── Envio de texto ─────────────────────────────────────────────────────────

async function enviarTexto(botToken: string, chatId: string, mensagem: string): Promise<void> {
  const url = `https://api.telegram.org/bot${botToken}/sendMessage`
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ chat_id: chatId, text: mensagem, parse_mode: 'HTML' }),
  })
  if (!res.ok) {
    const e = await res.json()
    throw new Error(`Telegram sendMessage: ${e.description}`)
  }
}

// ── Envio de fotos ─────────────────────────────────────────────────────────

async function enviarFotos(botToken: string, chatId: string, fotos: Uint8Array[], nomes: string[], caption: string): Promise<void> {
  if (fotos.length === 0) return

  if (fotos.length === 1) {
    const fd = new FormData()
    fd.append('chat_id', chatId)
    fd.append('caption', caption.slice(0, 1024))
    fd.append('parse_mode', 'HTML')
    fd.append('photo', new Blob([fotos[0]], { type: 'image/jpeg' }), nomes[0] || 'foto.jpg')

    const res = await fetch(`https://api.telegram.org/bot${botToken}/sendPhoto`, {
      method: 'POST',
      body: fd,
    })
    if (!res.ok) {
      const e = await res.json()
      throw new Error(`Telegram sendPhoto: ${e.description}`)
    }
    return
  }

  // ── 2 fotos — sendMediaGroup ────────────────────────────
  const fd = new FormData()
  fd.append('chat_id', chatId)

  const media = fotos.map((_, idx) => ({
    type: 'photo',
    media: `attach://foto${idx}`,
    ...(idx === 0 ? { caption: caption.slice(0, 1024), parse_mode: 'HTML' } : {}),
  }))

  fd.append('media', JSON.stringify(media))
  fotos.forEach((bytes, idx) => {
    fd.append(`foto${idx}`, new Blob([bytes], { type: 'image/jpeg' }), nomes[idx] || `foto${idx}.jpg`)
  })

  const res = await fetch(`https://api.telegram.org/bot${botToken}/sendMediaGroup`, {
    method: 'POST',
    body: fd,
  })
  if (!res.ok) {
    const e = await res.json()
    throw new Error(`Telegram sendMediaGroup: ${e.description}`)
  }
}

// ── Handler principal ──────────────────────────────────────────────────────

serve(async (req) => {
  if (req.method === 'OPTIONS') return new Response('ok', { headers: corsHeaders })

  try {
    // Validar JWT antes de qualquer coisa
    const autorizado = await validarJWT(req)
    if (!autorizado) return erroResp("Acesso não autorizado.", 401)

    // Lê config do banco (ou fallback para Secrets)
    const { botToken, groups } = await getTelegramConfig()
    if (!botToken) throw new Error("Token do Bot do Telegram não configurado. Configure na aba Telegram da Gestão.")

    const contentType = req.headers.get('content-type') ?? ''
    let mensagem = ''
    let regiao   = ''
    const fotoBytes: Uint8Array[] = []
    const fotoNomes: string[] = []

    if (contentType.includes('multipart/form-data')) {
      const form = await req.formData()
      mensagem = (form.get('mensagem') as string) ?? ''
      regiao   = (form.get('regiao')   as string) ?? ''

      for (let i = 0; i < 2; i++) {
        const entry = form.get(`foto${i}`)
        if (entry && entry instanceof File) {
          const buf = await entry.arrayBuffer()
          fotoBytes.push(new Uint8Array(buf))
          fotoNomes.push(entry.name || `foto${i}.jpg`)
        }
      }
    } else {
      const body = await req.json()
      mensagem = body.mensagem ?? ''
      regiao   = body.regiao   ?? ''
    }

    if (!mensagem || !regiao) {
      return erroResp("Os campos 'mensagem' e 'regiao' são obrigatórios.")
    }

    const chatId = groups[regiao.toUpperCase()]
    if (!chatId) {
      return erroResp(`Região inválida ou grupo não configurado (${regiao.toUpperCase()}). Configure na aba Telegram da Gestão.`)
    }

    if (fotoBytes.length > 0) {
      await enviarFotos(botToken, chatId, fotoBytes, fotoNomes, mensagem)
    } else {
      await enviarTexto(botToken, chatId, mensagem)
    }

    return okResp("Mensagem enviada ao Telegram.")

  } catch (err) {
    console.error('[enviar-telegram] Erro:', err.message)
    return erroResp(err.message)
  }
})
