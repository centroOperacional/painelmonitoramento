import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2.39.3";

import { corsHeaders } from "../_shared/cors.ts";

// Lê configurações do Telegram do banco, com fallback para Secrets
async function getTelegramConfig(supabaseAdmin: any): Promise<{ botToken: string; groups: Record<string, string> }> {
  const { data } = await supabaseAdmin.from('telegram_config').select('chave,valor')

  const config: Record<string, string> = {}
  if (data) {
    data.forEach((row: { chave: string; valor: string }) => {
      config[row.chave] = row.valor
    })
  }

  const botToken = config['BOT_TOKEN'] || Deno.env.get('TELEGRAM_BOT_TOKEN') || ''
  const groups: Record<string, string> = {}
  for (const regiao of ['NORTE', 'SUL', 'SERRA', 'TAQUARI']) {
    groups[regiao] = config[`GROUP_${regiao}`] || Deno.env.get(`TELEGRAM_GROUP_${regiao}`) || ''
  }

  return { botToken, groups }
}

serve(async (req) => {
  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });

  try {
    const supabaseAdmin = createClient(
      Deno.env.get("SUPABASE_URL") ?? "",
      Deno.env.get("SUPABASE_SERVICE_ROLE_KEY") ?? ""
    );

    // Lê config do banco (ou fallback para Secrets)
    const { botToken, groups } = await getTelegramConfig(supabaseAdmin)

    if (!botToken) {
      throw new Error("Token do Bot do Telegram não configurado. Configure na aba Telegram da Gestão ou nos Secrets.");
    }

    // Busca tickets ativos
    const { data: tickets, error } = await supabaseAdmin
      .from("tickets")
      .select("ttk, sp, cidade, tag, grupo_regiao")
      .order("grupo_regiao");

    if (error) throw error;

    const REGIOES = ["NORTE", "SUL", "SERRA", "TAQUARI"];
    const porGrupo: Record<string, any[]> = {};
    REGIOES.forEach(r => porGrupo[r] = []);

    if (tickets) {
      tickets.forEach(t => {
        const g = (t.grupo_regiao || "SUL").toUpperCase();
        if (porGrupo[g]) porGrupo[g].push(t);
      });
    }

    let enviados = 0;

    for (const grupo of REGIOES) {
      const lista = porGrupo[grupo];
      let mensagem = "";

      if (lista.length === 0) {
        mensagem = `🟢 <b>Bom dia!</b>\nNenhum serviço pendente na região <b>${grupo}</b>.`;
      } else {
        const linhas = lista.map(t =>
          `${t.ttk || "—"} - SP${t.sp || "—"} - ${t.cidade || "—"} - ${t.tag || "—"}`
        ).join("\n");
        mensagem = `🟡 <b>Bom dia!</b>\nSegue TTK's pendentes região <b>${grupo}</b>.\n\n${linhas}`;
      }

      const chatId = groups[grupo]
      if (!chatId) {
        console.warn(`[resumo-diario] Grupo ${grupo} não configurado na tabela telegram_config nem nos Secrets.`);
        continue;
      }

      const resTelegram = await fetch(`https://api.telegram.org/bot${botToken}/sendMessage`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          chat_id: chatId,
          text: mensagem,
          parse_mode: 'HTML'
        }),
      });

      if (resTelegram.ok) {
        enviados++;
      } else {
        const errData = await resTelegram.json().catch(() => ({}));
        console.error(`[resumo-diario] Falha ao enviar para ${grupo}:`, JSON.stringify(errData));
      }
    }

    return new Response(JSON.stringify({ ok: true, enviados }), {
      headers: { ...corsHeaders, "Content-Type": "application/json" },
      status: 200,
    });

  } catch (err) {
    return new Response(JSON.stringify({ error: err.message }), {
      headers: { ...corsHeaders, "Content-Type": "application/json" },
      status: 500,
    });
  }
});
